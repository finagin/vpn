**/.git
.idea
**/.gitignore
**/.gitattributes

# Cache and environment files
**/.sass-cache
*.env*
!.env*.encrypted

# Configuration and documentation files
phpunit.xml
README.md

# Docker related files
Dockerfile
docker-compose*.yml

# Other files
.dockerignore
.editorconfig
.github
http-client.*
