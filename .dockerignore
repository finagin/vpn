# Laravel specific files and directories
bootstrap/cache/*
public/build/*
storage/app/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
storage/*.key

# Vendor test files
vendor/**/test*
vendor/**/tests*
vendor/**/Tests*

# Node modules
**/node_modules

